# NEXT_PUBLIC environment variables for Nyxor Protocol web app
# Copy this file to .env.local and fill in your values.
# NEXT_PUBLIC_ variables are exposed to the browser; never put secrets here.

# ── Chain configuration ─────────────────────────────────────────────────────
# Active chain: "fuji" or "l1"
NEXT_PUBLIC_CHAIN=fuji

# ── Fuji C-Chain ────────────────────────────────────────────────────────────
# Custom Fuji RPC — optional, defaults to public endpoint.
# Use a dedicated endpoint (Infura, QuickNode, Alchemy) to avoid rate limits.
# Example: https://avalanche-fuji.infura.io/v3/YOUR_KEY
NEXT_PUBLIC_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Explorer base URL for Fuji (no trailing slash)
NEXT_PUBLIC_FUJI_EXPLORER=https://testnet.snowscan.xyz

# ── Nyxor L1 (stretch — fill in after L1 deployment) ───────────────────────
NEXT_PUBLIC_L1_CHAIN_ID=
NEXT_PUBLIC_L1_RPC_URL=
NEXT_PUBLIC_L1_EXPLORER=
NEXT_PUBLIC_L1_CHAIN_NAME=Nyxor L1

# ── Contract addresses ───────────────────────────────────────────────────────
# These are read from deployments/fuji.json at build time (see contracts.ts).
# Override them here only if you deploy to a different network.
# NEXT_PUBLIC_ADDR_DEMO_USDC=0x...
# NEXT_PUBLIC_ADDR_MARKET_CLOCK=0x...
# NEXT_PUBLIC_ADDR_MARKET_SCHEDULE=0x...
# NEXT_PUBLIC_ADDR_PERP_MARKET_STANDARD=0x...
# NEXT_PUBLIC_ADDR_PERP_MARKET_GUARDED=0x...
# NEXT_PUBLIC_ADDR_VAULT_STANDARD=0x...
# NEXT_PUBLIC_ADDR_VAULT_GUARDED=0x...
# NEXT_PUBLIC_ADDR_FEED_STANDARD=0x...
# NEXT_PUBLIC_ADDR_FEED_GUARDED=0x...
# NEXT_PUBLIC_ADDR_FLAT_RISK_POLICY=0x...
# NEXT_PUBLIC_ADDR_MARKET_HOURS_RISK_POLICY=0x...
# NEXT_PUBLIC_ADDR_DEPLOYER=0x...
